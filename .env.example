# AUREON — environment configuration (docs/ENVIRONMENT.md)
#
# Copy to .env.local for local development. NEVER commit .env.local or real credentials.
#
# Everything prefixed NEXT_PUBLIC_ is embedded in the JavaScript sent to every visitor.
# Only PUBLIC values may use that prefix. The build fails if a NEXT_PUBLIC_ variable holds a
# privileged Supabase key (sb_secret_… or a service_role JWT).

# ── Supabase (OPTIONAL) ───────────────────────────────────────────────────────────────
# Without these, AUREON works exactly as before: local data (IndexedDB) and LOCAL login.
# With them (Step 14), sign-in is Supabase Auth (email + password, verified email), done on the
# server with HttpOnly cookies. Financial data stays on the device (IndexedDB); nothing
# financial is sent to Supabase. Dashboard setup: docs/SUPABASE_SETUP.md §6–7 and §11.
#
# Project URL — Supabase Dashboard → Project Settings → Data API (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (recommended, sb_publishable_…) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key — only if the project has no publishable key (the publishable key wins).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of the app, used in verification/recovery email links (recommended in
# production; must be in Supabase → Authentication → URL Configuration). Ex.: https://aureon.example
NEXT_PUBLIC_SITE_URL=

# Server-only, NOT used by the app (Step 14 included). Never NEXT_PUBLIC_, never in the browser,
# never in Git. Reserved for CI/migrations (Step 13+); set it only where it is needed.
# SUPABASE_SECRET_KEY=

# ── Tooling ───────────────────────────────────────────────────────────────────────────
# Disable Next.js anonymous telemetry (also set in CI).
NEXT_TELEMETRY_DISABLED=1

# Local E2E only: use an existing Chrome/Chromium instead of `npx playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome

# Local E2E only: port for the production server started by Playwright (default 3200).
# E2E_PORT=3200
# Supabase-mode E2E (fake Auth server, playwright.supabase.config.ts): port of its server (default 3201).
# E2E_SUPABASE_PORT=3201
