# AUREON — environment configuration
#
# AUREON needs NO environment variables, locally or on Vercel: there is no backend, no
# database (no Supabase), no authentication and no remote API. Financial data lives only in
# each browser's IndexedDB. Copy to .env.local only if you need the optional values below.
#
# NEVER put secrets here or in any NEXT_PUBLIC_* variable: everything prefixed
# NEXT_PUBLIC_ is embedded in the JavaScript sent to every visitor (security rule SEC-02/03).
# The data passphrase is typed by the user in the browser and is never an env variable.

# Disable Next.js anonymous telemetry (also set in CI).
NEXT_TELEMETRY_DISABLED=1

# Local E2E only: use an existing Chrome/Chromium instead of `npx playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome

# Local E2E only: port for the production server started by Playwright (default 3200).
# E2E_PORT=3200
