{
  "name": "personal-finance-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AUREON — Personal Financial Intelligence: local-first, database-free personal finance PWA (ARS/USD).",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/pwa/build-sw.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:e2e:supabase": "node scripts/e2e/build-supabase-mode.mjs",
    "test:e2e:supabase": "playwright test -c playwright.supabase.config.ts",
    "tokens:build": "tsx scripts/design-tokens/build-tokens-css.ts",
    "tokens:check": "tsx scripts/design-tokens/build-tokens-css.ts --check",
    "schemas:build": "tsx scripts/data/generate-json-schemas.ts",
    "schemas:check": "tsx scripts/data/generate-json-schemas.ts --check",
    "data:validate": "tsx scripts/data/validate-data.ts",
    "guard:deps": "node scripts/guards/check-forbidden-deps.mjs",
    "guard:artifacts": "node scripts/guards/check-public-artifacts.mjs",
    "icons:build": "tsx scripts/pwa/generate-icons.ts",
    "check": "npm run guard:deps && npm run lint && npm run typecheck && npm run tokens:check && npm run schemas:check && npm run data:validate && npm run data:migrate -- --check && npm run data:changeset -- tests/fixtures/changesets/sample.changeset.json && npm test",
    "data:migrate": "tsx scripts/data/migrate-data.ts",
    "data:checksums": "tsx scripts/data/update-checksums.ts",
    "data:changeset": "tsx scripts/data/check-changeset.ts",
    "test:domain": "vitest run tests/unit/domain.test.ts tests/unit/money.test.ts",
    "test:data": "vitest run tests/unit/data-validation.test.ts tests/unit/compatibility.test.ts",
    "test:repositories": "vitest run tests/integration/local-store.test.ts tests/integration/repositories.test.ts",
    "test:migrations": "vitest run tests/unit/migrations.test.ts",
    "test:exchange": "vitest run tests/integration/exchange.test.ts tests/integration/published-source.test.ts",
    "test:security": "vitest run tests/unit/data-security.test.ts tests/unit/crypto.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
